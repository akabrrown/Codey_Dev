# API app — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Settings → API → Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase client (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose to browser

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=codey-quote-uploads     # Create as signed preset in Cloudinary

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend Dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=quotes@codeydev.com          # Must match your verified Resend domain
ADMIN_NOTIFICATION_EMAIL=codey.it360@gmail.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Arcjet Dashboard → Site → API Key
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Console → Redis Database → REST API
UPSTASH_REDIS_REST_URL=https://[database-name].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── App URLs ─────────────────────────────────────────────────────────────────
PUBLIC_PORTAL_URL=http://localhost:3000          # Change to https://codeydev.com in production
ADMIN_PORTAL_URL=http://localhost:3001           # Change to https://admin.codeydev.com in production
