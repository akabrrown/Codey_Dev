{
  "name": "codey-dev-portal",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:public": "turbo run dev --filter=@codey/public",
    "dev:admin": "turbo run dev --filter=@codey/admin",
    "dev:api": "turbo run dev --filter=@codey/api",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
